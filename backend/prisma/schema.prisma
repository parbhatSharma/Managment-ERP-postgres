generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  WITHDRAWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum FeeStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum AnnouncementAudience {
  ALL
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}
model User {
 id String @id @default(cuid())
 email String @unique
 passwordHash String
 firstName String
 lastName String
 phone String?
 avatarUrl String?
 role Role
 status UserStatus @default(ACTIVE)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 student Student?
 teacher Teacher?
 parent Parent?
 announcements Announcement[] @relation("AnnouncementAuthor")
 @@index([role, status])
}
model Student {
 id String @id @default(cuid())
 userId String @unique
 admissionNo String @unique
 dateOfBirth DateTime?
 gender String?
 address String?
 status StudentStatus @default(ACTIVE)
 sectionId String?
 joinedAt DateTime @default(now())
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 section Section? @relation(fields:[sectionId], references:[id])
 parents StudentParent[]
 attendance Attendance[]
 fees FeeRecord[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([sectionId, status])
}
model Parent {
 id String @id @default(cuid())
 userId String @unique
 occupation String?
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 students StudentParent[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model StudentParent {
 studentId String
 parentId String
 relationship String
 isPrimary Boolean @default(false)
 student Student @relation(fields:[studentId], references:[id], onDelete:Cascade)
 parent Parent @relation(fields:[parentId], references:[id], onDelete:Cascade)
 @@id([studentId,parentId])
}
model Teacher {
 id String @id @default(cuid())
 userId String @unique
 employeeNo String @unique
 qualification String?
 joinedAt DateTime @default(now())
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 classTeacherOf Section[] @relation("ClassTeacher")
 assignments TeacherSubject[]
 timetable TimetableEntry[]
 homework Assignment[]
 attendanceMarked Attendance[] @relation("MarkedBy")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model SchoolClass {
 id String @id @default(cuid())
 name String @unique
 sortOrder Int
 sections Section[]
 subjects ClassSubject[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([sortOrder])
}
model Section {
 id String @id @default(cuid())
 name String
 classId String
 classTeacherId String?
 capacity Int @default(40)
 schoolClass SchoolClass @relation(fields:[classId], references:[id], onDelete:Cascade)
 classTeacher Teacher? @relation("ClassTeacher", fields:[classTeacherId], references:[id])
 students Student[]
 attendance Attendance[]
 timetable TimetableEntry[]
 assignments Assignment[]
 teacherSubjects TeacherSubject[]
 @@unique([classId,name])
 @@index([classTeacherId])
}
model Subject {
 id String @id @default(cuid())
 code String @unique
 name String @unique
 color String @default("#2783DE")
 teachers TeacherSubject[]
 classes ClassSubject[]
 timetable TimetableEntry[]
 assignments Assignment[]
}
model TeacherSubject {
 id String @id @default(cuid())
 teacherId String
 subjectId String
 sectionId String
 teacher Teacher @relation(fields:[teacherId], references:[id], onDelete:Cascade)
 subject Subject @relation(fields:[subjectId], references:[id], onDelete:Cascade)
 section Section @relation(fields:[sectionId], references:[id], onDelete:Cascade)
 @@unique([teacherId,subjectId,sectionId])
}
model ClassSubject {
 classId String
 subjectId String
 schoolClass SchoolClass @relation(fields:[classId], references:[id], onDelete:Cascade)
 subject Subject @relation(fields:[subjectId], references:[id], onDelete:Cascade)
 @@id([classId,subjectId])
}
model Attendance {
 id String @id @default(cuid())
 studentId String
 sectionId String
 date DateTime @db.Date
 status AttendanceStatus
 note String?
 markedById String
 student Student @relation(fields:[studentId], references:[id], onDelete:Cascade)
 section Section @relation(fields:[sectionId], references:[id], onDelete:Cascade)
 markedBy Teacher @relation("MarkedBy", fields:[markedById], references:[id])
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([studentId,date])
 @@index([sectionId,date,status])
}
model TimetableEntry {
 id String @id @default(cuid())
 sectionId String
 subjectId String
 teacherId String
 day DayOfWeek
 period Int
 startsAt String
 endsAt String
 room String?
 section Section @relation(fields:[sectionId], references:[id], onDelete:Cascade)
 subject Subject @relation(fields:[subjectId], references:[id])
 teacher Teacher @relation(fields:[teacherId], references:[id])
 @@unique([sectionId,day,period])
 @@index([teacherId,day])
}
model Announcement {
 id String @id @default(cuid())
 title String
 body String
 audience AnnouncementAudience @default(ALL)
 published Boolean @default(true)
 pinned Boolean @default(false)
 authorId String
 author User @relation("AnnouncementAuthor", fields:[authorId], references:[id])
 publishedAt DateTime @default(now())
 expiresAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([audience,published,publishedAt])
}
model Assignment {
 id String @id @default(cuid())
 title String
 description String
 sectionId String
 subjectId String
 teacherId String
 dueAt DateTime
 attachmentUrl String?
 section Section @relation(fields:[sectionId], references:[id], onDelete:Cascade)
 subject Subject @relation(fields:[subjectId], references:[id])
 teacher Teacher @relation(fields:[teacherId], references:[id])
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([sectionId,dueAt])
}
model FeeRecord {
 id String @id @default(cuid())
 studentId String
 label String
 amount Decimal @db.Decimal(10,2)
 amountPaid Decimal @default(0) @db.Decimal(10,2)
 status FeeStatus @default(UNPAID)
 dueDate DateTime @db.Date
 student Student @relation(fields:[studentId], references:[id], onDelete:Cascade)
 payments FeePayment[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([studentId,status,dueDate])
}
model FeePayment {
 id String @id @default(cuid())
 feeRecordId String
 amount Decimal @db.Decimal(10,2)
 paidAt DateTime @default(now())
 method String
 reference String?
 feeRecord FeeRecord @relation(fields:[feeRecordId], references:[id], onDelete:Cascade)
 @@index([feeRecordId,paidAt])
}
